# Copiar para api/.env. Credenciais EXCLUSIVAMENTE de desenvolvimento.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookspace
DB_PASSWORD=bookspace_local
DB_NAME=bookspace
# Usada apenas pelo Compose; a API nunca deve conectar como root.
MYSQL_ROOT_PASSWORD=root_local_trocar
# Origens web separadas por vírgula. Apps nativos não enviam Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SESSION_HOURS=8
# A seed exige development e esta confirmação explícita.
ALLOW_DEV_SEED=false
SEED_EMAIL=demo@bookspace.test
SEED_PASSWORD=DemoLocal!12345
SEED_PIN=4826
